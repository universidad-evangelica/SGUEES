<?xml version="1.0" encoding="utf-8"?>
<!-- Se aplica al Publicar / compilar en Release desde Visual Studio. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="JWT_AUDIENCE_TOKEN"
         value="http://192.168.0.250/sguees-rpt/api/"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="JWT_ISSUER_TOKEN"
         value="http://192.168.0.250/sguees-rpt/api/"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
